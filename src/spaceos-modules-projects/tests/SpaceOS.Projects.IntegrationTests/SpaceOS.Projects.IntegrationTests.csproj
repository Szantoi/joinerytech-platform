<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!--
      Each fixture starts its own PostgreSQL container. Run in parallel they starve the Docker
      host and fail in ~1 ms with the container never coming up — a red suite that says nothing
      about the code. Serialised, the same suite is deterministic; the price is wall-clock.
    -->
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared interceptor's fail-loud check resolves IHttpContextAccessor. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- The E2E create-path test boots the real host (Program) around the container database. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Matches what Npgsql.EntityFrameworkCore.PostgreSQL 8.0.11 pulls in; a lower pin is a
         package downgrade and the build treats that as an error. -->
    <PackageReference Include="Npgsql" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\SpaceOS.Projects.Domain\SpaceOS.Projects.Domain.csproj" />
    <ProjectReference Include="..\..\src\SpaceOS.Projects.Application\SpaceOS.Projects.Application.csproj" />
    <ProjectReference Include="..\..\src\SpaceOS.Projects.Infrastructure\SpaceOS.Projects.Infrastructure.csproj" />
    <ProjectReference Include="..\..\host\SpaceOS.Projects.Host.csproj" />
    <!--
      The STAB-RLS-PROOF fixture: a real PostgreSQL container plus a NOSUPERUSER/NOBYPASSRLS
      application role. Without the non-superuser role every RLS assertion here would pass even
      with the policies deleted, because superusers bypass RLS unconditionally.
    -->
    <ProjectReference Include="..\..\..\spaceos-modules-hosting\tests\SpaceOS.Modules.Hosting.RlsFixtures\SpaceOS.Modules.Hosting.RlsFixtures.csproj" />
  </ItemGroup>
</Project>
